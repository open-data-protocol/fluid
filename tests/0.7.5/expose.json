    {
      "description": "the seven kind values not exercised elsewhere, one per expose entry, with an iceberg block on the last",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "raw_files",
            "kind": "file",
            "binding": {
              "platform": "aws",
              "format": "s3_file",
              "location": { "bucket": "acme-raw", "path": "landing/events/" }
            },
            "contract": { "schema": [{ "name": "path", "type": "string" }] }
          },
          {
            "exposeId": "customer_topic",
            "kind": "topic",
            "binding": {
              "platform": "gcp",
              "format": "pubsub_topic",
              "location": { "topic": "customer-updates" }
            },
            "contract": { "schema": [{ "name": "event_id", "type": "string" }] }
          },
          {
            "exposeId": "customer_features",
            "kind": "feature_store",
            "binding": {
              "platform": "databricks",
              "format": "delta_table",
              "location": { "database": "features", "table": "customer_features" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] }
          },
          {
            "exposeId": "customer_embeddings",
            "kind": "vector",
            "binding": {
              "platform": "other",
              "format": "other",
              "location": { "path": "s3://ml-vectors/customers" }
            },
            "contract": { "schema": [{ "name": "embedding", "type": "array" }] }
          },
          {
            "exposeId": "customer_graph",
            "kind": "graph",
            "binding": {
              "platform": "other",
              "format": "other",
              "location": { "path": "s3://graph-store/customers" }
            },
            "contract": { "schema": [{ "name": "node_id", "type": "string" }] }
          },
          {
            "exposeId": "customer_metrics_ts",
            "kind": "time_series",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "metrics", "table": "customer_ts" }
            },
            "contract": { "schema": [{ "name": "ts", "type": "timestamp" }] }
          },
          {
            "exposeId": "legacy_export",
            "kind": "other",
            "binding": {
              "platform": "azure",
              "format": "other",
              "location": { "account": "acmestorage", "path": "exports/legacy.csv" }
            },
            "contract": { "schema": [{ "name": "raw", "type": "string" }] },
            "iceberg": {
              "writeFormat": "parquet",
              "snapshotRetention": { "maxSnapshotAgeMs": 604800000, "minSnapshotsToKeep": 5 },
              "compaction": { "enabled": true, "targetFileSizeMb": 512 }
            }
          }
        ]
      },
      "valid": true
