{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "expose",
  "description": "The expose object: its four required members, its closed property set, the full breadth of the kind enum, the mcp and iceberg member shapes, exposeId against the identifier grammar, and version against semver.",
  "cases": [
    {
      "description": "version sits at the lowest permissible semver value",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "raw_events",
            "version": "0.0.0",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "raw", "table": "events" }
            },
            "contract": { "schema": [{ "name": "event_id", "type": "string" }] }
          }
        ]
      },
      "valid": true
    },
    {
      "description": "optional title, description, version, tags and labels populated on a view",
