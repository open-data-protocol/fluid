{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "lineage-ml",
  "description": "The optional lineage block (granularity, upstream dependency entries with their fieldMappings/transformation nesting and relationship enum, and downstream consumer entries with the impact enum), the schemaEvolution block (strategy/compatibility enums and the nested changePolicy object), and the machineLearning block (framework enum and model entries with their required fields, type enum, and nested validation object) -- including every closed object's additionalProperties:false boundary.",
  "cases": [
    {
      "description": "lineage, schemaEvolution and machineLearning populated to their nested edges",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            }
          }
        ],
        "lineage": {
          "granularity": "field_level",
          "upstream": [
            {
              "productId": "raw_events",
              "exposeId": "events_table",
              "relationship": "aggregation",
              "fieldMappings": [
                {
                  "sourceField": "event_ts",
                  "targetField": "profile_updated_at",
                  "transformation": {
                    "type": "calculation",
                    "expression": "MAX(event_ts)"
                  }
                }
              ]
            }
          ],
          "downstream": [
            {
              "consumer": "churn_model",
              "impact": "high"
            }
          ]
        },
        "schemaEvolution": {
          "strategy": "semantic_versioning",
          "compatibility": "backward_compatible",
          "changePolicy": {
            "changeWindowDays": 14,
            "approvalRequired": true,
            "approvers": [
              "data-governance"
            ]
          }
        },
        "machineLearning": {
          "enabled": true,
          "framework": "mlflow",
          "models": [
            {
              "name": "churn_predictor",
              "version": "1.2.0",
              "type": "classification",
              "algorithm": "xgboost",
              "features": [
                "tenure_days",
                "monthly_spend"
              ],
              "target": "churned",
              "validation": {
                "metrics": [
                  "accuracy",
                  "auc_roc"
                ],
                "thresholds": {
                  "accuracy": 0.85
                }
              }
            }
          ]
        }
      },
      "valid": true
    },
