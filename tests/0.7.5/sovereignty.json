  "group": "sovereignty",
  "description": "The top-level sovereignty block: its own object type, the jurisdiction and enforcementMode enums, the allowedRegions/deniedRegions/transferMechanisms/regulatoryFramework arrays (their array type, item type/enum, and uniqueItems), the dataResidency/crossBorderTransfer/validationRequired booleans, and the block's closed property set.",
  "cases": [
    {
      "description": "EU jurisdiction with strict enforcement and no cross-border transfer",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "sovereignty": {
          "jurisdiction": "EU",
          "allowedRegions": ["eu-west-1", "eu-central-1"],
          "deniedRegions": ["us-east-1"],
          "dataResidency": true,
          "crossBorderTransfer": false,
          "regulatoryFramework": ["GDPR"],
          "enforcementMode": "strict",
          "validationRequired": true
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] }
          }
        ]
      },
      "valid": true
    },
