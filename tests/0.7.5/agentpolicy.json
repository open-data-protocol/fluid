{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "agentpolicy",
  "description": "agentPolicy, the AI/LLM usage-governance block reachable at exposes[].policy.agentPolicy: its eleven governance members, their types and bounds, and the closed property set that keeps 'reporting yes, training no' policies from silently drifting.",
  "cases": [
    {
      "description": "agentPolicy sets a full model, usage, and retention governance profile",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] },
            "policy": {
              "agentPolicy": {
                "allowedModels": ["gpt-4", "claude-3-opus", "claude-3-sonnet"],
                "deniedModels": ["gpt-3.5-turbo-finetuned-marketing"],
                "maxTokensPerRequest": 8192,
                "maxTokensPerDay": 500000,
                "allowedUseCases": ["inference", "reasoning", "summarization"],
                "deniedUseCases": ["training", "fine_tuning"],
                "canReason": true,
                "canStore": false,
                "retentionPolicy": { "maxRetentionDays": 30, "requireDeletion": true },
                "auditRequired": true,
                "purposeLimitation": "Customer service chatbot only, not for marketing or profiling."
              }
            }
          }
        ]
      },
      "valid": true
    },
