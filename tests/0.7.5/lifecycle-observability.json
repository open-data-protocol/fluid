    {
      "description": "an expose declares an active lifecycle, a full observability configuration, and boundary-value QoS targets",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] },
            "lifecycle": { "state": "active" },
            "observability": {
              "metrics": [
                { "name": "row_count", "source": "warehouse.metrics.row_count", "sli": "row_count > 0" }
              ],
              "onBreach": [
                {
                  "type": "pagerduty",
                  "channel": "data-platform-oncall",
                  "target": "customer-profiles-service",
                  "severity": "critical",
                  "tags": ["p1"],
                  "labels": { "escalation": "immediate" }
                }
              ],
              "defaultSLIs": {
                "enabled": false,
                "freshness": {
                  "enabled": true,
                  "threshold": "PT6H",
                  "severity": "warning",
                  "tags": ["freshness"],
                  "labels": { "sla": "gold" }
                },
                "completeness": { "enabled": true, "threshold": 1, "severity": "critical" },
                "latency": { "enabled": true, "threshold": "PT5S", "percentile": 0, "severity": "info" },
                "tags": ["default-sli"],
                "labels": { "generated-by": "forge-cli" }
              },
              "alert": {
                "channels": [
                  { "kind": "webhook", "url": "https://hooks.acme.com/alerts/customer-profiles" }
                ]
              },
              "tags": ["observability"],
              "labels": { "observed-by": "data-platform" }
            },
            "qos": {
              "availability": "100%",
              "freshnessSLO": "PT15M",
              "dataLossSLO": "0 rows",
              "latencyP95": "PT5S",
              "completenessTarget": 1,
              "errorBudget": 0,
              "tags": ["sla"],
              "labels": { "tier": "gold" }
            }
          }
        ]
      },
      "valid": true
    },
