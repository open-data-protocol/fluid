{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "primitives",
  "description": "The shared primitive grammars referenced throughout the document: identifier, semver, semverRange, tags, labels, isoDuration, availabilityPct and lifecycleState. Each is exercised at one or more of its real usage sites (exposeId, expose.version, qos, lifecycle, consumes), not only where the envelope group already pins it down.",
  "cases": [
    {
      "description": "a document exercising tags, labels, semver with prerelease and build metadata, QoS availability and freshness, lifecycle state and retention, and a consumed version constraint together",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "tags": ["customer-data", "pii"],
        "labels": { "team": "customer-analytics", "cost-center": "engineering" },
        "metadata": {
          "owner": { "team": "customer-analytics" },
          "tags": ["gold-tier"]
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "version": "2.1.0-beta.1+exp.sha.abc123",
            "tags": ["real-time"],
            "labels": { "region": "us-central1" },
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] },
            "qos": {
              "availability": "99.95%",
              "freshnessSLO": "PT15M"
            },
            "lifecycle": {
              "state": "active",
              "retention": "P365D",
              "deprecationPolicy": { "noticePeriod": "P30D" }
            }
          }
        ],
        "consumes": [
          { "productId": "silver.hr.people", "exposeId": "people_v2", "versionConstraint": "^1.2.0" }
        ]
      },
      "valid": true
    },
