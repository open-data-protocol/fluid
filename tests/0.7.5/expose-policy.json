  "group": "expose-policy",
  "description": "The exposePolicy block reached via exposes[].policy: its own closed property set, the authn enum, the authz sub-object (closed property set, columnRestrictions items' closed property set and access enum), the privacy sub-object (closed property set, masking items' required column/strategy, closed property set and strategy enum, rowLevelPolicy's required expression and closed property set), and the classification enum.",
  "cases": [
    {
      "description": "policy block populated with authn, authz, privacy, and classification",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] },
            "policy": {
              "authn": "oidc",
              "authz": {
                "readers": ["group:analytics"],
                "writers": ["group:platform"],
                "columnRestrictions": [
                  {
                    "principal": "group:analytics",
                    "columns": ["ssn"],
                    "access": "deny",
                    "tags": ["pii-guard"],
                    "labels": { "reviewed-by": "security-team" }
                  }
                ],
                "tags": ["policy-authz"],
                "labels": { "owner-team": "security" }
              },
              "privacy": {
                "masking": [
                  {
                    "column": "ssn",
                    "strategy": "tokenize",
                    "params": { "format": "fpe" },
                    "tags": ["masking-rule"],
                    "labels": { "applies-to": "ssn" }
                  }
                ],
                "rowLevelPolicy": {
                  "expression": "region = current_region()",
                  "tags": ["rls-rule"],
                  "labels": { "scope": "region" }
                },
                "tags": ["privacy-policy"],
                "labels": { "data-class": "sensitive" }
              },
              "classification": "Confidential",
              "tags": ["policy-top"],
              "labels": { "policy-owner": "governance-team" }
            }
          }
        ]
      },
      "valid": true
    },
