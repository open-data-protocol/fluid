{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "build-consumes",
  "description": "The build block and its four pattern variants (hybrid-reference, embedded-logic, multi-stage, acquisition) -- including each variant's own closed property set, not just its required member -- the build-level capabilities vocabulary and dependencies[].condition enum, the builds array of independent build configurations, the consumes array and consumeRef, and the inline environments overrides object. A conformant implementation reproduces every verdict below.",
  "cases": [
    {
      "description": "hybrid-reference build carries every optional member: outputs, dependencies, tags, labels, an adapter-qualified engine, and pattern-specific select/materializations/vars",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] }
          }
        ],
        "build": {
          "id": "stg_customers_build",
          "description": "Staging build for customer profile enrichment.",
          "pattern": "hybrid-reference",
          "engine": "dbt-snowflake",
          "outputs": ["profiles_table"],
          "dependencies": [{ "buildId": "raw_customers_build", "condition": "success" }],
          "tags": ["batch"],
          "labels": { "team": "customer-analytics" },
          "properties": {
            "model": "stg_customers",
            "select": ["stg_customers", "+downstream"],
            "materializations": { "stg_customers": "incremental" },
            "vars": { "start_date": "2024-01-01" }
          }
        }
      },
      "valid": true
    },
