{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "expose-mcp",
  "description": "The exposeMcp gateway block (exposes[].mcp: sampling.maxRows, classification.dataClass) and the completeness/latency members of defaultSLIs (exposes[].observability.defaultSLIs): each object's closed property set and the dataClass/severity enums.",
  "cases": [
    {
      "description": "expose combines an MCP gateway block with completeness and latency SLI severities",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] },
            "mcp": {
              "sampling": { "maxRows": 500 },
              "classification": { "dataClass": "confidential" }
            },
            "observability": {
              "defaultSLIs": {
                "enabled": true,
                "completeness": { "severity": "info" },
                "latency": { "severity": "critical" }
              }
            }
          }
        ]
      },
      "valid": true
    },
