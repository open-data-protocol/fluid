{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "contract-schema",
  "description": "The tabular contract surface of an expose: schemaSignature and schemaPolicy on exposeContract, the schema/openapiRef anyOf, the guarantees and simplified quality sub-objects, the column required-field, minLength and closed property-set rules, the deliberately generous column.type anyOf (canonical enum plus a parameterised cross-dialect pattern), sensitivity classification against sensitivityLevel, and the dqSpec/dqRule required members, enums and monitoring block.",
  "cases": [
    {
      "description": "signed schema, evolve_safe policy, parameterized decimal column, dq rule with optional operator/threshold/window",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                },
                {
                  "name": "lifetime_value",
                  "type": "decimal(18,4)"
                }
              ],
              "schemaSignature": "sha256:a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4a1b2c3d4",
              "schemaPolicy": "evolve_safe",
              "dq": {
                "rules": [
                  {
                    "id": "freshness_customer_id",
                    "type": "freshness",
                    "severity": "warn",
                    "operator": ">=",
                    "threshold": 0.95,
                    "window": "P1D"
                  }
                ],
                "monitoring": {
                  "enabled": true,
                  "window": "PT15M",
                  "owner": "data-eng"
                }
              }
            }
          }
        ]
      },
      "valid": true
    },
