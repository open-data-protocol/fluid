{
  "corpusVersion": "0.7.6",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.6.json",
  "group": "lifecycle-expire-bucketpolicy",
  "description": "Expose-level additions in 0.7.6 preview: lifecycle.expire (a boolean on the expose lifecycle, which keeps the closed property set of 0.7.5's lifecycle plus that one member), and lakeFormation.bucketPolicy's enum.",
  "cases": [
    {
      "description": "an expose lifecycle declares a retention period and opts in to expiry",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            },
            "lifecycle": {
              "state": "active",
              "retention": "P90D",
              "expire": true
            }
          }
        ]
      },
      "valid": true
    },
    {
      "description": "lifecycle.expire is a string instead of a boolean",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            },
            "lifecycle": {
              "retention": "P90D",
              "expire": "true"
            }
          }
        ]
      },
      "valid": false,
      "errors": [
        {
          "pointer": "/exposes/0/lifecycle/expire",
          "keyword": "type"
        }
      ]
    },
    {
      "description": "the expose lifecycle carries a property outside its closed set",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            },
            "lifecycle": {
              "retention": "P90D",
              "expireAfter": "P90D"
            }
          }
        ]
      },
      "valid": false,
      "errors": [
        {
          "pointer": "/exposes/0/lifecycle",
          "keyword": "additionalProperties",
          "detail": "expireAfter"
        }
      ]
    },
    {
      "description": "lakeFormation.bucketPolicy restricts the S3 bucket policy to no statements",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "aws",
              "format": "iceberg",
              "location": {
                "bucket": "acme-lake",
                "path": "warehouse/customers/profiles"
              },
              "governance": {
                "lakeFormation": {
                  "registerLocation": true,
                  "grants": [
                    {
                      "principal": "arn:aws:iam::123456789012:role/analytics-reader",
                      "permissions": [
                        "SELECT"
                      ]
                    }
                  ],
                  "bucketPolicy": "none"
                }
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            }
          }
        ]
      },
      "valid": true
    },
    {
      "description": "lakeFormation.bucketPolicy names a scope outside its enum",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "aws",
              "format": "iceberg",
              "location": {
                "bucket": "acme-lake",
                "path": "warehouse/customers/profiles"
              },
              "governance": {
                "lakeFormation": {
                  "registerLocation": true,
                  "grants": [
                    {
                      "principal": "arn:aws:iam::123456789012:role/analytics-reader",
                      "permissions": [
                        "SELECT"
                      ]
                    }
                  ],
                  "bucketPolicy": "same-account"
                }
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            }
          }
        ]
      },
      "valid": false,
      "errors": [
        {
          "pointer": "/exposes/0/binding/governance/lakeFormation/bucketPolicy",
          "keyword": "enum"
        }
      ]
    }
  ]
}
