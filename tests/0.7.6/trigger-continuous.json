{
  "corpusVersion": "0.7.6",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.6.json",
  "group": "trigger-continuous",
  "description": "build.execution.trigger.type continuous (0.7.6): a long-lived job whose platform keeps it running, so its trigger takes no other trigger. cron, schedule, datasets, event and timetable are each refused next to it; every other trigger type keeps accepting them; a trigger that is not an object gets exactly one error; and each trigger member keeps its own type.",
  "cases": [
    {
      "description": "a continuous trigger names the type and nothing else",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            }
          }
        ],
        "build": {
          "pattern": "embedded-logic",
          "engine": "flink",
          "properties": {
            "sql": "INSERT INTO payments_reconciled SELECT * FROM payments"
          },
          "execution": {
            "trigger": {
              "type": "continuous"
            }
          }
        }
      },
      "valid": true
    },
