{
  "corpusVersion": "0.7.6",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.6.json",
  "group": "masking-aggparams",
  "description": "Typed parameters added in 0.7.6 preview: masking params' saltEnv/keyEnv environment-variable-name pattern and keepFirst/keepLast integer bounds (0..64), which leave params open to other members as the schema states; and a semantic measure's closed aggParams object with its 0..1 percentile bounds.",
  "cases": [
    {
      "description": "masking params name the salt and key environment variables and keep a prefix and suffix",
      "contract": {
        "fluidVersion": "0.7.6",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": {
          "owner": {
            "team": "customer-analytics"
          }
        },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": {
                "project": "acme-prod",
                "dataset": "customers",
                "table": "profiles"
              }
            },
            "contract": {
              "schema": [
                {
                  "name": "customer_id",
                  "type": "string"
                }
              ]
            },
            "policy": {
              "privacy": {
                "masking": [
                  {
                    "column": "email",
                    "strategy": "mask",
                    "params": {
                      "saltEnv": "FLUID_PII_HASH_SECRET",
                      "keyEnv": "PII_KEY",
                      "keepFirst": 0,
                      "keepLast": 64
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "valid": true
    },
