{
  "corpusVersion": "0.7.5",
  "schema": "https://open-data-protocol.github.io/fluid/schema/fluid-schema-0.7.5.json",
  "group": "metadata",
  "description": "Format-assertion cases for the metadata object: `format` is an annotation, not an assertion, in JSON Schema Draft 2020-12, so an implementation may legitimately accept these documents. These cases exist for implementations that opt into asserting owner.email and metadata.createdAt.",
  "cases": [
    {
      "description": "owner email is not a well-formed email address",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics", "email": "not-an-email" } },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] }
          }
        ]
      },
      "valid": false,
      "errors": [{ "pointer": "/metadata/owner/email", "keyword": "format" }]
    },
    {
      "description": "createdAt holds a bare date with no time component",
      "contract": {
        "fluidVersion": "0.7.5",
        "kind": "DataProduct",
        "id": "customer_profiles",
        "name": "Customer Profiles",
        "metadata": { "owner": { "team": "customer-analytics" }, "createdAt": "2024-03-01" },
        "exposes": [
          {
            "exposeId": "profiles_table",
            "kind": "table",
            "binding": {
              "platform": "gcp",
              "format": "bigquery_table",
              "location": { "project": "acme-prod", "dataset": "customers", "table": "profiles" }
            },
            "contract": { "schema": [{ "name": "customer_id", "type": "string" }] }
          }
        ]
      },
      "valid": false,
      "errors": [{ "pointer": "/metadata/createdAt", "keyword": "format" }]
    }
  ]
}
